{
  "name": "opencontact-monorepo",
  "private": true,
  "description": "Put your business's AI agent in your customers' Messages app. Skills for any agent harness plus a local iMessage bridge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CINTELLILABS/opencontact.git"
  },
  "homepage": "https://github.com/CINTELLILABS/opencontact#readme",
  "bugs": "https://github.com/CINTELLILABS/opencontact/issues",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm run lint:skills && biome check .",
    "lint:skills": "node scripts/check-skills.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3"
  }
}
